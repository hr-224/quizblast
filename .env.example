APP_NAME=QuizBlast
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default — no setup required)
DB_CONNECTION=sqlite

# MySQL / MariaDB (uncomment and fill in to use instead of SQLite)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=quizblast
# DB_USERNAME=root
# DB_PASSWORD=

# ─── Cache / Sessions / Queue ─────────────────────────────────────────────────
BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log

# ─── WebSockets (Laravel Reverb) ──────────────────────────────────────────────
# Run `php artisan reverb:start` in a second terminal to enable real-time features.
# See docs/websockets.md for production configuration.
REVERB_APP_ID=quizblast
REVERB_APP_KEY=changeme_app_key
REVERB_APP_SECRET=changeme_app_secret
REVERB_ALLOWED_ORIGINS=*

# Client connection settings (what the browser connects to)
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Server binding settings (what the Reverb process listens on)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
